# Needed for AI tagging of uploaded clothing (category, colors, pattern, etc.).
# Without it the app still works: you tag items by hand and colors are detected locally.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3001

# Optional: self-host the background-removal model files (defaults to the img.ly CDN)
# VITE_BG_MODEL_URL=https://your-cdn.example.com/background-removal/
